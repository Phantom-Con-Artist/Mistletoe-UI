/*
    Mistletoe splash (generated by scripts/gen-lookandfeel.py).

    The login screen carried on: same wallpaper, clock and branding, and
    where the password shard was, a rotary dial. KSplash counts the session's
    start-up in six stages; at each one the dial turns a detent, bringing the
    next gem up to the stop at the top, where it lights.
*/
import QtQuick

MistletoeScene {
    id: root

    // Set by KSplash: 1..6 as the session comes up.
    property int stage: 0
    readonly property int stages: 6
    readonly property real dialRadius: 40

    Item {
        id: dial
        anchors.horizontalCenter: parent.horizontalCenter
        width: root.dialRadius * 2
        // Room above for the stop, so it clears the name.
        height: width + 16

        Item {
            id: face
            width: root.dialRadius * 2
            height: width
            y: 16

            // The mark, still at the center.
            Image {
                anchors.centerIn: parent
                width: Math.round(root.dialRadius * 1.05)
                height: width
                sourceSize: Qt.size(width * 2, height * 2)
                source: Qt.resolvedUrl("mistletoe-mark.svg")
                fillMode: Image.PreserveAspectFit
            }

            // Hairline orbit.
            Rectangle {
                anchors.fill: parent
                radius: width / 2
                color: "transparent"
                border.width: 1
                border.color: root.tint(root.gold, 0.45)
            }

            // The finger stop: a fixed gold mark above the orbit.
            Rectangle {
                width: 2
                height: 7
                anchors.horizontalCenter: parent.horizontalCenter
                y: -14
                color: root.gold
            }

            // The ring of gems turns one detent per stage.
            Item {
                anchors.fill: parent
                rotation: -root.stage * 360 / root.stages
                Behavior on rotation {
                    NumberAnimation {
                        duration: 520
                        easing.type: Easing.OutBack
                        easing.overshoot: 1.1
                    }
                }

                Repeater {
                    model: root.stages
                    Item {
                        id: detent
                        required property int index
                        // Gem 1 reaches the stop at stage 1, gem 2 at stage 2, ...
                        readonly property int number: index + 1
                        readonly property bool lit: root.stage >= number
                        readonly property real angle: number * 2 * Math.PI / root.stages
                        x: root.dialRadius + root.dialRadius * Math.sin(angle)
                        y: root.dialRadius - root.dialRadius * Math.cos(angle)

                        Rectangle {
                            width: detent.lit ? 11 : 8
                            height: width
                            x: -width / 2
                            y: -height / 2
                            rotation: 45
                            antialiasing: true
                            color: detent.lit ? root.gold : root.ink
                            border.width: 1
                            border.color: detent.lit ? root.gold : root.tint(root.bone, 0.5)
                            Behavior on color {
                                ColorAnimation { duration: 300 }
                            }
                        }
                    }
                }
            }
        }
    }
}
