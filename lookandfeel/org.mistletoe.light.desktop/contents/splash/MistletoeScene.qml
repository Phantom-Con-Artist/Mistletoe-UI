/*
    The Mistletoe screen scene (generated by scripts/gen-lookandfeel.py):
    the lock screen's presentation, for the splash and the leave screen.
    Children are placed low in the centre, where the lock screen has its
    password shard. Sizes follow lockscreen/LockScreenUi.qml exactly.
*/
import QtQuick
import QtCore

Item {
    id: scene

    readonly property color ink: "#e3ded0"
    readonly property color bone: "#111316"
    readonly property color gold: "#967034"
    readonly property color black: "#0b0c0e"
    readonly property color white: "#f4f1ea"

    // Wallpaper, name, and whether the wallpaper is light behind each text
    // (written by `mistletoe-menu lock-settings`). Missing: a plain field.
    readonly property var look: appearance.status === Loader.Ready ? appearance.item : null
    readonly property bool clockLight: look ? look.clockOnLight : false
    readonly property bool badgeLight: look ? look.badgeOnLight : false
    readonly property bool centerLight: look ? look.centerOnLight : false
    readonly property string userName: look ? look.userName : ""

    default property alias content: center.data
    readonly property alias centerItem: center

    function tint(c, a) {
        return Qt.rgba(c.r, c.g, c.b, a);
    }
    function textOn(onLight) {
        return onLight ? black : white;
    }
    function shadowOn(onLight) {
        return onLight ? Qt.rgba(1, 1, 1, 0.35) : Qt.rgba(0, 0, 0, 0.6);
    }

    Loader {
        id: appearance
        source: StandardPaths.writableLocation(StandardPaths.GenericDataLocation) + "/mistletoe/Appearance.qml"
    }

    Rectangle {
        anchors.fill: parent
        color: scene.ink
    }
    Image {
        anchors.fill: parent
        source: scene.look ? scene.look.wallpaper : ""
        fillMode: Image.PreserveAspectCrop
        sourceSize: Qt.size(scene.width, scene.height)
        smooth: true
    }
    // The veil: matte, as deep as the lock screen's while you type.
    Rectangle {
        anchors.fill: parent
        color: scene.ink
        opacity: 0.62
    }

    // ---- Clock -------------------------------------------------------------
    property date now: new Date()
    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: scene.now = new Date()
    }
    Column {
        x: Math.round(scene.width * 0.07)
        y: Math.round(scene.height * 0.3)
        spacing: 0
        Text {
            text: Qt.formatDate(scene.now, "dddd").toUpperCase()
            color: scene.gold
            style: Text.Raised
            styleColor: scene.shadowOn(scene.clockLight)
            font.family: "Mistletoe Display"
            font.pixelSize: Math.round(scene.height * 0.022)
            font.letterSpacing: Math.round(scene.height * 0.008)
        }
        Text {
            text: Qt.formatTime(scene.now, "hh:mm")
            color: scene.textOn(scene.clockLight)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.clockLight)
            font.family: "Mistletoe Display"
            font.pixelSize: Math.round(scene.height * 0.2)
        }
        Rectangle {
            width: parent.width * 0.62
            height: 1
            color: scene.tint(scene.gold, 0.8)
        }
        Text {
            topPadding: Math.round(scene.height * 0.014)
            text: Qt.formatDate(scene.now, "d MMMM yyyy")
            color: scene.tint(scene.textOn(scene.clockLight), 0.85)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.clockLight)
            font.family: "Mistletoe Accent"
            font.pixelSize: Math.round(scene.height * 0.03)
        }
    }

    // ---- Branding, top right ---------------------------------------------------
    Row {
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.rightMargin: Math.round(scene.height * 0.045)
        anchors.topMargin: Math.round(scene.height * 0.035)
        spacing: 8
        Text {
            anchors.verticalCenter: parent.verticalCenter
            visible: text.length > 0
            text: String(scene.look ? scene.look.distro : "").toUpperCase()
            color: scene.tint(scene.textOn(scene.badgeLight), 0.8)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.badgeLight)
            font.family: "Mistletoe Display"
            font.pixelSize: 11
            font.letterSpacing: 2
        }
        Text {
            anchors.verticalCenter: parent.verticalCenter
            visible: scene.look !== null && scene.look.distro.length > 0
            text: "using"
            color: scene.tint(scene.textOn(scene.badgeLight), 0.6)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.badgeLight)
            font.family: "Mistletoe Accent"
            font.pixelSize: 13
        }
        Image {
            anchors.verticalCenter: parent.verticalCenter
            width: 22
            height: 22
            sourceSize: Qt.size(44, 44)
            source: Qt.resolvedUrl("mistletoe-mark.svg")
        }
        Text {
            anchors.verticalCenter: parent.verticalCenter
            textFormat: Text.StyledText
            text: "Mistletoe <font color=\"" + scene.gold + "\">UI</font>"
            color: scene.textOn(scene.badgeLight)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.badgeLight)
            font.family: "Mistletoe Text"
            font.pixelSize: 13
            font.weight: Font.DemiBold
        }
    }

    // ---- Centre: where the lock screen has your name and the password shard ----
    Column {
        id: center
        readonly property real w: Math.round(Math.min(560, scene.width * 0.8))
        x: (scene.width - w) / 2
        y: Math.round(scene.height * 0.68)
        width: w
        spacing: 14

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            visible: text.length > 0
            text: scene.userName.toUpperCase()
            color: scene.textOn(scene.centerLight)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.centerLight)
            font.family: "Mistletoe Display"
            font.pixelSize: 14
            font.letterSpacing: 4
        }
    }
}
