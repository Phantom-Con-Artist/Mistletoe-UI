/*
    Mistletoe leave screen (generated by scripts/gen-lookandfeel.py): what
    you see when you ask to sleep, restart, shut down or log out.

    The lock screen's scene, with the actions as gems where the password
    shard would be. The action you asked for is selected and runs when the
    countdown ends; arrows or the pointer choose another (and stop the
    countdown), Enter runs it, Esc or a click on the backdrop cancels.
*/
import QtQuick
import org.kde.kirigami as Kirigami
import org.kde.plasma.private.sessions

Item {
    id: root

    height: screenGeometry.height
    width: screenGeometry.width

    signal logoutRequested()
    signal haltRequested()
    signal haltUpdateRequested()
    signal suspendRequested(int spdMethod)
    signal rebootRequested()
    signal rebootRequested2(int opt)
    signal rebootUpdateRequested()
    signal cancelRequested()
    signal lockScreenRequested()
    signal cancelSoftwareUpdateRequested()

    property real timeout: 30
    property real remainingTime: timeout
    readonly property bool showAllOptions: sdtype === ShutdownType.ShutdownTypeDefault
    readonly property string domain: "plasma_lookandfeel_org.kde.lookandfeel"

    function plain(s) {
        return String(s).replace("&", "");
    }

    // Every action that applies now, in order; `wanted` marks the one asked for.
    readonly property var actions: {
        const all = showAllOptions;
        const reboot = sdtype === ShutdownType.ShutdownTypeReboot;
        const halt = sdtype === ShutdownType.ShutdownTypeHalt;
        const none = sdtype === ShutdownType.ShutdownTypeNone;
        const updates = softwareUpdatePending;
        return [
            { icon: "system-suspend", label: plain(i18ndc(domain, "Suspend to RAM", "Slee&p")),
              on: spdMethods.SuspendState && all, wanted: false, run: () => root.suspendRequested(2) },
            { icon: "system-suspend-hibernate", label: plain(i18nd(domain, "&Hibernate")),
              on: spdMethods.HibernateState && all, wanted: false, run: () => root.suspendRequested(4) },
            { icon: updates ? "system-reboot-update" : "system-reboot",
              label: updates ? i18ndc(domain, "@action:button Keep short", "Install Updates and Restart") : plain(i18nd(domain, "&Restart")),
              on: maysd && (reboot || all), wanted: reboot,
              run: () => updates ? root.rebootUpdateRequested() : root.rebootRequested() },
            { icon: "system-reboot", label: plain(i18nd(domain, "&Restart")),
              on: maysd && updates && (reboot || all), wanted: false, run: () => root.rebootRequested() },
            { icon: updates ? "system-shutdown-update" : "system-shutdown",
              label: updates ? i18ndc(domain, "@action:button Keep short", "Install Updates and Shut Down") : plain(i18nd(domain, "&Shut Down")),
              on: maysd && (halt || all), wanted: halt || all,
              run: () => updates ? root.haltUpdateRequested() : root.haltRequested() },
            { icon: "system-shutdown", label: plain(i18nd(domain, "&Shut Down")),
              on: maysd && updates && (halt || all), wanted: false, run: () => root.haltRequested() },
            { icon: "system-log-out", label: plain(i18nd(domain, "&Log Out")),
              on: canLogout && (none || all), wanted: none, run: () => root.logoutRequested() },
            { icon: "dialog-cancel", label: plain(i18nd(domain, "&Cancel")),
              on: true, wanted: false, run: () => root.cancelRequested() }
        ].filter(a => a.on);
    }
    property int current: 0
    function pickWanted() {
        for (let i = 0; i < actions.length; ++i) {
            if (actions[i].wanted) {
                current = i;
                return;
            }
        }
        current = 0;
    }
    Component.onCompleted: {
        pickWanted();
        keys.forceActiveFocus();
    }

    // The countdown runs only when one action was asked for outright.
    property bool counting: !showAllOptions
    Timer {
        running: root.counting
        repeat: true
        interval: 1000
        onTriggered: {
            root.remainingTime--;
            if (root.remainingTime <= 0) {
                root.counting = false;
                for (const a of root.actions) {
                    if (a.wanted) {
                        a.run();
                        return;
                    }
                }
                root.logoutRequested();
            }
        }
    }
    function choose(i) {
        counting = false;
        current = Math.max(0, Math.min(actions.length - 1, i));
    }

    SessionsModel {
        id: otherSessions
        includeUnusedSessions: false
        includeOwnSession: false
    }

    MistletoeScene {
        id: scene
        anchors.fill: parent

        // Click the backdrop to cancel.
        MouseArea {
            parent: scene
            anchors.fill: parent
            z: -1
            onClicked: root.cancelRequested()
        }

        Row {
            id: gems
            anchors.horizontalCenter: parent.horizontalCenter
            spacing: 6

            Repeater {
                model: root.actions.length
                MouseArea {
                    id: gem
                    required property int index
                    readonly property var action: root.actions[index] || ({})
                    readonly property bool hot: root.current === index
                    width: Math.max(96, label.implicitWidth + 20)
                    height: 86
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onEntered: root.choose(index)
                    onClicked: action.run()

                    // A diamond gem, gold when chosen.
                    Rectangle {
                        width: 38
                        height: 38
                        x: (parent.width - width) / 2
                        y: 10
                        rotation: 45
                        antialiasing: true
                        color: gem.hot ? scene.gold : scene.tint(scene.ink, 0.85)
                        border.width: 1
                        border.color: gem.hot ? scene.gold : scene.tint(scene.bone, 0.4)
                        Behavior on color {
                            ColorAnimation { duration: 140 }
                        }
                    }
                    Kirigami.Icon {
                        x: (parent.width - width) / 2
                        y: 19
                        width: 20
                        height: 20
                        source: gem.action.icon || ""
                        isMask: true
                        color: gem.hot ? scene.ink : scene.bone
                        animated: false
                    }
                    Text {
                        id: label
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        text: String(gem.action.label || "").toUpperCase()
                        color: gem.hot ? scene.gold : scene.tint(scene.textOn(scene.centerLight), 0.75)
                        style: Text.Raised
                        styleColor: scene.shadowOn(scene.centerLight)
                        font.family: "Mistletoe Display"
                        font.pixelSize: 10
                        font.letterSpacing: 1.5
                    }
                }
            }
        }

        // Countdown and warnings, like the lock screen's messages.
        Text {
            width: parent.width
            horizontalAlignment: Text.AlignHCenter
            wrapMode: Text.WordWrap
            visible: text.length > 0
            color: scene.textOn(scene.centerLight)
            style: Text.Raised
            styleColor: scene.shadowOn(scene.centerLight)
            font.family: "Mistletoe Text"
            font.pixelSize: 13
            lineHeight: 1.3
            text: {
                const lines = [];
                if (root.counting) {
                    switch (sdtype) {
                    case ShutdownType.ShutdownTypeReboot:
                        lines.push(softwareUpdatePending
                            ? i18ndp(root.domain, "Installing software updates and restarting in 1 second", "Installing software updates and restarting in %1 seconds", root.remainingTime)
                            : i18ndp(root.domain, "Restarting in 1 second", "Restarting in %1 seconds", root.remainingTime));
                        break;
                    case ShutdownType.ShutdownTypeNone:
                        lines.push(i18ndp(root.domain, "Logging out in 1 second", "Logging out in %1 seconds", root.remainingTime));
                        break;
                    default:
                        lines.push(softwareUpdatePending
                            ? i18ndp(root.domain, "Installing software updates and shutting down in 1 second", "Installing software updates and shutting down in %1 seconds", root.remainingTime)
                            : i18ndp(root.domain, "Shutting down in 1 second", "Shutting down in %1 seconds", root.remainingTime));
                    }
                }
                if (otherSessions.count > 0 && (sdtype !== ShutdownType.ShutdownTypeNone || root.showAllOptions)) {
                    lines.push(i18ndp(root.domain,
                        "One other user is currently logged in. If the computer is shut down or restarted, that user may lose work.",
                        "%1 other users are currently logged in. If the computer is shut down or restarted, those users may lose work.",
                        otherSessions.count));
                }
                if (rebootToFirmwareSetup) {
                    lines.push(isUefi
                        ? i18nd(root.domain, "When restarted, the computer will enter UEFI firmware settings.")
                        : i18nd(root.domain, "When restarted, the computer will enter the firmware setup screen."));
                }
                if (rebootToBootLoaderMenu) {
                    lines.push(i18nd(root.domain, "When restarted, the computer will enter the boot loader menu."));
                }
                if (rebootToBootLoaderEntry != "") {
                    lines.push(i18ndc(root.domain, "%1 is a boot loader entry", "When restarted, the computer will switch to %1.", rebootToBootLoaderEntry));
                }
                return lines.join("\n");
            }
        }
    }

    Item {
        id: keys
        focus: true
        Keys.onPressed: (event) => {
            switch (event.key) {
            case Qt.Key_Escape:
                root.cancelRequested();
                break;
            case Qt.Key_Left:
            case Qt.Key_Backtab:
                root.choose((root.current + root.actions.length - 1) % root.actions.length);
                break;
            case Qt.Key_Right:
            case Qt.Key_Tab:
                root.choose((root.current + 1) % root.actions.length);
                break;
            case Qt.Key_Return:
            case Qt.Key_Enter:
            case Qt.Key_Space:
                if (root.actions[root.current]) {
                    root.actions[root.current].run();
                }
                break;
            default:
                return;
            }
            event.accepted = true;
        }
    }
}
