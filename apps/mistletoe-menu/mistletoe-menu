#!/usr/bin/env python3
"""Mistletoe menu bridge: lets the radial dial read and drive any app's menus
(and lists places for its Places mode).

KDE/Qt apps (and GTK apps with appmenu-gtk-module) export their menu bar
over D-Bus (com.canonical.dbusmenu) once Plasma's AppMenu registrar is
running. Plasma starts that registrar only while a "menu view" owns
org.kde.kappmenuview on the session bus, so `serve` holds that name.

  mistletoe-menu serve                     keep the registrar alive
  mistletoe-menu dump SERVICE PATH         print the menu tree as JSON
  mistletoe-menu click SERVICE PATH ID     activate one entry
  mistletoe-menu places                    print places, recent folders,
                                           drives and network as JSON
  mistletoe-menu sync-wallpaper            give the active Mistletoe edition
                                           its wallpaper (see below)
  mistletoe-menu fonts [ROLE=FAMILY ...]   set the font roles (display, accent,
                                           text); no arguments re-applies
  mistletoe-menu edition NAME              switch edition: dark, light, neon, ember
  mistletoe-menu options                   editions and font choices as JSON
  mistletoe-menu backdrop X Y W H SW SH    "light" or "dark": the wallpaper's
                                           brightness behind a desktop rect
  mistletoe-menu lock-settings             refresh what the lock screen reads
                                           (text contrast, distro line)

The dial gets SERVICE and PATH for the active window from Plasma's task
model and runs `dump` / `click` through Plasma's executable data source.
"""
import configparser
import fcntl
import json
import os
import sqlite3
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path
from urllib.parse import unquote, urlparse

from gi.repository import Gio, GLib

IFACE = "com.canonical.dbusmenu"


def bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def call(service, path, method, params, reply):
    return bus().call_sync(service, path, IFACE, method, params,
                           GLib.VariantType.new(reply), Gio.DBusCallFlags.NONE, 3000, None)


KEYS = {"Control": "Ctrl", "Super": "Meta", "Return": "Enter", "Escape": "Esc"}


def pretty_shortcut(shortcut):
    """[["Control", "Shift", "N"]] -> "Ctrl+Shift+N" (first binding only)."""
    if not shortcut or not shortcut[0]:
        return ""
    return "+".join(KEYS.get(k, k) for k in shortcut[0])


def node(item):
    """(id, props, children) -> {id, label, icon, enabled, checked, children}."""
    ident, props, children = item
    label = props.get("label", "")
    # Mnemonics: "&File" -> "File", "&&" -> "&".
    label = label.replace("&&", "\0").replace("&", "").replace("_", "").replace("\0", "&")
    kids = [node(c) for c in children]
    return {
        "id": ident,
        "label": label,
        "icon": props.get("icon-name", ""),
        "enabled": props.get("enabled", True),
        "visible": props.get("visible", True),
        "separator": props.get("type", "") == "separator",
        "checked": props.get("toggle-state", -1) == 1,
        "shortcut": pretty_shortcut(props.get("shortcut")),
        "children": [k for k in kids if k["visible"] and not k["separator"] and k["label"]],
    }


def prepare(service, path, ident):
    # Menus are often built lazily; ask the app to fill a submenu first.
    try:
        call(service, path, "AboutToShow", GLib.Variant("(i)", (ident,)), "(b)")
    except GLib.Error:
        pass


def dump(service, path):
    prepare(service, path, 0)
    top = call(service, path, "GetLayout", GLib.Variant("(iias)", (0, 1, [])), "(u(ia{sv}av))").unpack()[1]
    for child in top[2]:
        prepare(service, path, child[0])
    layout = call(service, path, "GetLayout", GLib.Variant("(iias)", (0, -1, [])), "(u(ia{sv}av))").unpack()[1]
    print(json.dumps(node(layout)["children"]))


def click(service, path, ident):
    call(service, path, "Event",
         GLib.Variant("(isvu)", (int(ident), "clicked", GLib.Variant("i", 0), int(time.time()))), "()")


# ---- Places -------------------------------------------------------------
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def entry(label, icon, url, detail=""):
    return {"label": label, "icon": icon, "url": url, "detail": detail}


def pretty_path(path):
    home = str(Path.home())
    return "~" + path[len(home):] if path.startswith(home) else path


def dolphin_places():
    """Dolphin's Places panel (user-places.xbel): local ones, then the rest."""
    local, other = [], []
    try:
        root = ET.parse(DATA / "user-places.xbel").getroot()
    except (OSError, ET.ParseError):
        return local, other
    for b in root.iter("bookmark"):
        meta = {m.tag.split("}")[-1]: m for m in b.iter()}
        if meta.get("IsHidden") is not None and meta["IsHidden"].text == "true":
            continue
        if meta.get("OnlyInApp") is not None and meta["OnlyInApp"].text:
            continue
        href = b.get("href", "")
        icon = meta["icon"].get("name") if "icon" in meta else "folder"
        title = b.findtext("title") or href
        if href.startswith("recentlyused:"):
            continue  # the Recent group covers these
        if href.startswith("file://"):
            local.append(entry(title, icon, href, pretty_path(unquote(urlparse(href).path))))
        else:
            other.append(entry(title, icon, href, href))
    return local, other


def recent_folders(limit=12):
    """Folders you used lately, from KDE's activity database: folders
    themselves, or the folder of a file you opened."""
    db = DATA / "kactivitymanagerd" / "resources" / "database"
    out, seen = [], set()
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT targettedResource FROM ResourceScoreCache "
            "WHERE targettedResource LIKE '/%' OR targettedResource LIKE 'file:%' "
            "ORDER BY lastUpdate DESC LIMIT 400").fetchall()
    except sqlite3.Error:
        return out
    for (res,) in rows:
        path = unquote(urlparse(res).path) if res.startswith("file:") else res
        folder = path if os.path.isdir(path) else os.path.dirname(path)
        # Only your own folders (Home itself is already under Places) and
        # removable drives; system paths like /dev are noise here.
        mine = folder.startswith(str(Path.home()) + "/") or folder.startswith(("/run/media/", "/media/", "/mnt/"))
        if not mine or folder in seen or not os.path.isdir(folder):
            continue
        if any(part.startswith(".") for part in Path(folder).parts):
            continue  # hidden folders (caches, configs)
        seen.add(folder)
        out.append(entry(os.path.basename(folder) or folder, "folder", Path(folder).as_uri(), pretty_path(folder)))
        if len(out) >= limit:
            break
    return out


def drives():
    """Mounted drives: the system disk and anything under /run/media, /media, /mnt."""
    try:
        raw = subprocess.run(["findmnt", "-J", "--real", "-b", "-o", "TARGET,SOURCE,FSTYPE,LABEL,SIZE,AVAIL"],
                             capture_output=True, text=True, timeout=5).stdout
        mounts = json.loads(raw)["filesystems"]
    except Exception:
        return []

    def human(n):
        n = float(n or 0)
        for unit in "BKMGT":
            if n < 1024 or unit == "T":
                return f"{n:.0f} {unit}B" if unit != "B" else f"{n:.0f} B"
            n /= 1024

    out, seen = [], set()
    for m in mounts:
        target = m["target"]
        removable = target.startswith(("/run/media/", "/media/", "/mnt/"))
        if target != "/" and not removable:
            continue
        device = m["source"].split("[")[0]
        if device in seen:
            continue
        seen.add(device)
        name = m.get("label") or ("System" if target == "/" else os.path.basename(target))
        out.append(entry(name, "drive-removable-media" if removable else "drive-harddisk",
                         Path(target).as_uri(), f"{human(m.get('avail'))} free of {human(m.get('size'))}  ·  {m['fstype']}"))
    return out


def places():
    local, other = dolphin_places()
    groups = [
        {"name": "Places", "icon": "user-home", "entries": local},
        {"name": "Recent", "icon": "document-open-recent", "entries": recent_folders()},
        {"name": "Devices", "icon": "drive-harddisk", "entries": drives()},
        {"name": "Network & Trash", "icon": "folder-network", "entries": other},
    ]
    print(json.dumps([g for g in groups if g["entries"]]))


# ---- Edition wallpapers ---------------------------------------------------
# Plasma won't replace a wallpaper you've set when a Global Theme is applied,
# so the dial calls this whenever the colour scheme changes. Neon and Ember
# bring their own wallpaper; going back to Dark or Light from one of them
# restores Vigil. A custom picture stays until the next edition change.
EDITION_WALLPAPER = {"org.mistletoe.dark.desktop": "Mistletoe",
                     "org.mistletoe.light.desktop": "Mistletoe",
                     "org.mistletoe.neon.desktop": "Mistletoe-Neon",
                     "org.mistletoe.ember.desktop": "Mistletoe-Ember"}


def current_wallpapers():
    conf = CONFIG / "plasma-org.kde.plasma.desktop-appletsrc"
    desktop = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        desktop.read_string(conf.read_text())
    except OSError:
        return []
    images = []
    for section in desktop.sections():
        if not section.startswith("Containments][") or not section.endswith("][Wallpaper][org.kde.image][General"):
            continue
        parent = section.split("][Wallpaper]", 1)[0]
        if desktop.get(parent, "plugin", fallback="") not in ("org.kde.plasma.folder", "org.kde.desktop"):
            continue
        screen = desktop.getint(parent, "lastScreen", fallback=-1)
        image = desktop.get(section, "Image", fallback="")
        if image and screen >= 0:
            images.append((screen != 0, screen, image))
    return [image for _, _, image in sorted(images)]


def ensure_gtk_layer():
    """KDE rewrites gtk.css when the colours change; keep our import in it."""
    for v in ("3.0", "4.0"):
        css = CONFIG / f"gtk-{v}" / "gtk.css"
        if (CONFIG / f"gtk-{v}" / "mistletoe.css").exists():
            text = css.read_text() if css.exists() else ""
            if "mistletoe.css" not in text:
                css.write_text(text.rstrip("\n") + "\n@import 'mistletoe.css';\n")


def sync_wallpaper(force=False):
    # The dial and the settings watcher can notice the same theme change.
    CONFIG.mkdir(parents=True, exist_ok=True)
    with (CONFIG / "mistletoe-wallpaper.lock").open("a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        _sync_wallpaper(force)


def _sync_wallpaper(force=False):
    ensure_gtk_layer()
    lnf = subprocess.run(["kreadconfig6", "--group", "KDE", "--key", "LookAndFeelPackage"],
                         capture_output=True, text=True).stdout.strip()
    sync_kvantum(lnf)
    images = current_wallpapers()
    if not images:
        return
    previous = kread("Wallpaper", "LastLookAndFeel")
    image = images[0]
    if lnf in EDITION_WALLPAPER and (force or (previous and previous != lnf)):
        want = EDITION_WALLPAPER[lnf]
        result = subprocess.run(["plasma-apply-wallpaperimage", str(DATA / "wallpapers" / want)], capture_output=True)
        if result.returncode:
            print(result.stderr.decode(errors="replace"), file=sys.stderr)
            return
        flush_wallpaper()
        image = (DATA / "wallpapers" / want).as_uri()
        print("wallpaper ->", want)
    if previous != lnf:
        subprocess.run(["kwriteconfig6", "--file", "mistletoerc", "--group", "Wallpaper",
                        "--key", "LastLookAndFeel", lnf], capture_output=True)
    # The lock screen shows the same wallpaper as the desktop.
    image = Path(unquote(urlparse(image).path)).resolve().as_uri()
    subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter", "--group", "Wallpaper",
                    "--group", "org.kde.image", "--group", "General", "--key", "Image",
                    image], capture_output=True)
    lock_settings()


def sync_kvantum(lnf):
    """Point Kvantum (the widget style of Qt apps) at the active edition's
    theme. Kvantum keeps its choice in its own file, which a Global Theme
    can't set; apps pick it up when they next start."""
    edition = lnf.removeprefix("org.mistletoe.").removesuffix(".desktop")
    name = "Mistletoe" + edition.capitalize()
    folder = CONFIG / "Kvantum"
    if edition not in EDITIONS or not (folder / name / f"{name}.kvconfig").exists():
        return
    target = folder / "kvantum.kvconfig"
    wanted = f"theme={name}"
    try:
        lines = target.read_text().splitlines()
    except OSError:
        lines = []
    if wanted in lines:
        return
    if any(line.startswith("theme=") for line in lines):
        lines = [wanted if line.startswith("theme=") else line for line in lines]
    else:
        lines = ["[General]", wanted] + [line for line in lines if line != "[General]"]
    target.write_text("\n".join(lines) + "\n")
    print("kvantum ->", name)


def flush_wallpaper():
    # Wallpaper scripting writes can precede Plasma's normal config save.
    # reloadConfig requests that save without rebuilding the desktop layout.
    bus().call_sync("org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "evaluateScript",
                    GLib.Variant("(s)", ("var ds = desktops(); for (var i = 0; i < ds.length; ++i) ds[i].reloadConfig();",)),
                    GLib.VariantType.new("(s)"), Gio.DBusCallFlags.NONE, 3000, None)


# ---- Fonts and editions ------------------------------------------------------
# Every Mistletoe surface names a font *role*, never a family. The roles are
# fontconfig aliases, so changing one here changes it everywhere at once:
# widgets, lock screen, and (through kdeglobals) the apps' UI font.
ROLES = {
    "display": ("Mistletoe Display", "Ad Astra", "Clocks, figures and small-caps headings"),
    "accent": ("Mistletoe Accent", "Mythril", "Dates and large captions"),
    "text": ("Mistletoe Text", "Exo 2", "Everyday text, and apps' UI font"),
}
FAMILIES = {
    "Ad Astra": "Futuristic: faceted monoline",
    "Mythril": "Whimsical: soft monoline with curls",
    "Exo 2": "Geometric sans",
}
EDITIONS = {
    "dark": ("Mistletoe Dark", "Obsidian and champagne gold"),
    "light": ("Mistletoe Light", "Bone and bronze"),
    "neon": ("Mistletoe Neon", "Violet-black and orchid, with the Neon wallpaper"),
    "ember": ("Mistletoe Ember", "Charcoal and vermilion, with the Ember wallpaper"),
}


def kread(group, key, default=""):
    out = subprocess.run(["kreadconfig6", "--file", "mistletoerc", "--group", group, "--key", key],
                         capture_output=True, text=True).stdout.strip()
    return out or default


def chosen_fonts():
    return {role: kread("Fonts", role, spec[1]) for role, spec in ROLES.items()}


def write_fonts(choice):
    rules = "\n".join(
        f'  <alias binding="strong"><family>{ROLES[r][0]}</family>'
        f'<prefer><family>{choice[r]}</family></prefer></alias>' for r in ROLES)
    conf = CONFIG / "fontconfig" / "conf.d" / "60-mistletoe.conf"
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text('<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n'
                    "<!-- Mistletoe font roles; written by mistletoe-menu fonts. -->\n"
                    f"<fontconfig>\n{rules}\n</fontconfig>\n")
    subprocess.run(["fc-cache", "-f"], capture_output=True)


def fonts(args):
    choice = chosen_fonts()
    for arg in args:
        role, _, family = arg.partition("=")
        if role in ROLES and family:
            choice[role] = family
            subprocess.run(["kwriteconfig6", "--file", "mistletoerc", "--group", "Fonts",
                            "--key", role, family], capture_output=True)
    write_fonts(choice)
    # Running apps pick up the new font; the shell caches fonts, so restart it.
    subprocess.run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
                    "org.kde.KGlobalSettings.notifyChange", "int32:1", "int32:0"], capture_output=True)
    if args:
        subprocess.Popen(["systemctl", "--user", "restart", "plasma-plasmashell"])
    print(json.dumps(choice))


def edition(name):
    if name not in EDITIONS:
        raise SystemExit(f"unknown edition {name}")
    subprocess.run(["plasma-apply-lookandfeel", "--apply", f"org.mistletoe.{name}.desktop"], capture_output=True)
    subprocess.run(["kwriteconfig6", "--file", "konsolerc", "--group", "Desktop Entry", "--key",
                    "DefaultProfile", f"Mistletoe{name.capitalize()}.profile"], capture_output=True)
    sync_wallpaper(force=True)


def options():
    lnf = subprocess.run(["kreadconfig6", "--group", "KDE", "--key", "LookAndFeelPackage"],
                         capture_output=True, text=True).stdout.strip()
    groups = [{
        "name": "Edition", "icon": "preferences-desktop-theme-global",
        "entries": [{"label": label, "detail": detail, "checked": lnf == f"org.mistletoe.{key}.desktop",
                     "command": f"edition {key}"} for key, (label, detail) in EDITIONS.items()],
    }]
    choice = chosen_fonts()
    for role, (alias, _, what) in ROLES.items():
        groups.append({
            "name": role.capitalize() + " font", "icon": "preferences-desktop-font",
            "entries": [{"label": fam, "detail": f"{what}  ·  {desc}", "checked": choice[role] == fam,
                         "command": f"fonts {role}='{fam}'"} for fam, desc in FAMILIES.items()],
        })
    print(json.dumps(groups))


# ---- Backdrop brightness ---------------------------------------------------------
def wallpaper_file():
    """The image file of the primary desktop's wallpaper (or None)."""
    images = current_wallpapers()
    if not images:
        return None
    path = Path(unquote(urlparse(images[0]).path))
    if path.is_dir():   # a wallpaper package: its largest image
        pics = sorted((path / "contents" / "images").glob("*"), key=lambda p: p.stat().st_size)
        if not pics:
            return None
        path = pics[-1]
    return path if path.is_file() else None


def wallpaper_luma(sw, sh):
    """The current wallpaper as a greyscale image scaled and cropped to the
    screen, the way Plasma's "Scaled and Cropped" fill shows it (or None)."""
    from PIL import Image
    path = wallpaper_file()
    if not path:
        return None
    im = Image.open(path).convert("L")
    scale = max(sw / im.width, sh / im.height)
    im = im.resize((max(1, round(im.width * scale)), max(1, round(im.height * scale))))
    ox, oy = (im.width - sw) // 2, (im.height - sh) // 2
    return im.crop((ox, oy, ox + sw, oy + sh))


def region_light(im, x, y, w, h, veil=0.0):
    """Mean brightness of a rectangle, after a dark veil of this opacity."""
    region = im.crop((max(0, int(x)), max(0, int(y)), min(im.width, int(x + w)), min(im.height, int(y + h))))
    hist = region.histogram()
    mean = sum(i * n for i, n in enumerate(hist)) / max(1, sum(hist)) / 255
    return mean * (1 - veil) + 0.05 * veil > 0.5


def backdrop(x, y, w, h, sw, sh):
    """Is the wallpaper behind this desktop rectangle light or dark? Text
    drawn straight on the wallpaper picks black or white from this."""
    im = wallpaper_luma(sw, sh)
    print("light" if im and region_light(im, x, y, w, h) else "dark")


def screen_size():
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=5).stdout
        for o in json.loads(out)["outputs"]:
            if o.get("enabled") and o.get("size"):
                return o["size"]["width"], o["size"]["height"]
    except Exception:
        pass
    return 1920, 1080


def lock_settings():
    """What the lock screen can't work out itself: whether the wallpaper,
    under its dimming veil, is light behind the clock, the prompt and the
    branding, and the distro line (see lockscreen/backdrop.js)."""
    sw, sh = screen_size()
    im = wallpaper_luma(sw, sh)
    values = {}
    if im:
        values["clockOnLight"] = region_light(im, sw * 0.07, sh * 0.3, sw * 0.32, sh * 0.3, veil=0.38)
        values["promptOnLight"] = region_light(im, (sw - 420) / 2, sh * 0.66, 420, 40, veil=0.62)
        values["badgeOnLight"] = region_light(im, sw - 540, 0, 540, sh * 0.08, veil=0.38)
    try:
        info = dict(line.split("=", 1) for line in Path("/etc/os-release").read_text().splitlines() if "=" in line)
        values["distro"] = (info.get("NAME", "").strip('"') + " " + info.get("VERSION_ID", "").strip('"')).strip()
    except OSError:
        pass
    # Written into the installed copy of the lock screen package (install.sh
    # copies it rather than linking, so the repo stays clean).
    target = DATA / "plasma" / "shells" / "org.mistletoe.lockscreen" / "contents" / "lockscreen" / "backdrop.js"
    if target.parent.is_dir() and not target.parent.resolve().is_relative_to(Path(__file__).resolve().parents[2]):
        js = ["// Written by mistletoe-menu lock-settings; see lockscreen/backdrop.js in the repo.", ".pragma library"]
        for key, value in values.items():
            js.append(f"var {key} = {json.dumps(value)};")
        target.write_text("\n".join(js) + "\n")
    session_screens(im, sw, sh, values.get("distro", ""))
    return values


def session_screens(im, sw, sh, distro):
    """What the splash and the leave (sleep, restart, shut down) screens need
    to look like the lock screen: the wallpaper file, whether it is light
    behind the clock and the branding under their veil, the distro line and
    your name. They are part of the Global Theme packages, which can't hold
    per-machine values, so these go in a small QML object they load from
    ~/.local/share/mistletoe/Appearance.qml."""
    import pwd
    veil = 0.62
    path = wallpaper_file()
    try:
        name = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0] or os.environ.get("USER", "")
    except KeyError:
        name = os.environ.get("USER", "")
    props = {
        "wallpaper": path.as_uri() if path else "",
        "clockOnLight": bool(im and region_light(im, sw * 0.07, sh * 0.3, sw * 0.32, sh * 0.3, veil=veil)),
        "badgeOnLight": bool(im and region_light(im, sw - 540, 0, 540, sh * 0.08, veil=veil)),
        "centerOnLight": bool(im and region_light(im, (sw - 560) / 2, sh * 0.62, 560, sh * 0.2, veil=veil)),
        "distro": distro,
        "userName": name,
    }
    lines = ["// Written by mistletoe-menu lock-settings for the splash and leave screens.", "import QtQml", "", "QtObject {"]
    for key, value in props.items():
        kind = "bool" if isinstance(value, bool) else "string"
        lines.append(f"    readonly property {kind} {key}: {json.dumps(value)}")
    lines.append("}")
    target = DATA / "mistletoe" / "Appearance.qml"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(lines) + "\n")


def serve():
    Gio.bus_own_name_on_connection(bus(), "org.kde.kappmenuview", Gio.BusNameOwnerFlags.NONE, None, None)
    # Directory monitoring includes KConfig's atomic file replacements.
    # Debounce palette and global-theme writes into one wallpaper update.
    monitor = Gio.File.new_for_path(str(CONFIG)).monitor_directory(Gio.FileMonitorFlags.NONE, None)
    pending = 0
    def refresh():
        nonlocal pending
        pending = 0
        try:
            sync_wallpaper()
        except Exception as error:
            print(f"Wallpaper sync failed: {error}", file=sys.stderr)
        return GLib.SOURCE_REMOVE
    def changed(_monitor, file, other, _event):
        nonlocal pending
        names = {p.get_basename() for p in (file, other) if p is not None}
        if not names & {"kdeglobals", "plasma-org.kde.plasma.desktop-appletsrc"}:
            return
        if pending:
            GLib.source_remove(pending)
        pending = GLib.timeout_add(600, refresh)
    monitor.connect("changed", changed)
    refresh()
    GLib.MainLoop().run()


def main(argv):
    try:
        if argv[:1] == ["serve"]:
            serve()
        elif argv[:1] == ["dump"] and len(argv) == 3:
            dump(argv[1], argv[2])
        elif argv[:1] == ["click"] and len(argv) == 4:
            click(argv[1], argv[2], argv[3])
        elif argv[:1] == ["places"]:
            places()
        elif argv[:1] == ["sync-wallpaper"]:
            sync_wallpaper()
        elif argv[:1] == ["fonts"]:
            fonts(argv[1:])
        elif argv[:1] == ["edition"] and len(argv) == 2:
            edition(argv[1])
        elif argv[:1] == ["options"]:
            options()
        elif argv[:1] == ["backdrop"] and len(argv) == 7:
            backdrop(*map(int, argv[1:]))
        elif argv[:1] == ["lock-settings"]:
            print(json.dumps(lock_settings()))
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except GLib.Error as e:
        print(json.dumps({"error": e.message}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
